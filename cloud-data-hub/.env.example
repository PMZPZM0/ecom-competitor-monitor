# Public address configuration
PORT=4328
COOKIE_SECURE=true

# Persistent team data directory. Use a separate, backed-up disk path in a
# systemd deployment. Docker Compose overrides this with its named volume.
CLOUD_HUB_DATA_DIR=/var/lib/ecom-operations-cloud-hub

# Create the first platform administrator on an empty database. Keep both
# values private and change the password before sharing the server.
CLOUD_ADMIN_USERNAME=owner
CLOUD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Stable server-side secret used to encrypt recoverable team invitation and
# device codes. Generate once and keep it unchanged across restarts.
MANAGED_CODE_ENCRYPTION_SECRET=replace-with-a-long-random-secret

